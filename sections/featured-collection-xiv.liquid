{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 989px) {
    #collection-{{ section.id }} {
      margin: 0 2rem !important;
    }
  }

  #collection-{{ section.id }} .xiv-collection-item .card__inner {
    background-color: {{ section.settings.card_background_color | default: '#f5f7fb' }} !important;
    {%- if section.settings.card_border_radius > 0 -%}
      border-radius: {{ section.settings.card_border_radius }}px !important;
    {%- endif -%}
    {%- if section.settings.card_border_color != blank -%}
      border-color: {{ section.settings.card_border_color }};
    {%- endif -%}
  }

  @media screen and (min-width: 990px) {
    #collection-{{ section.id }} .xiv-collection-item {
      width: {{ section.settings.card_width | default: 366 }}px;
      max-width: {{ section.settings.card_width | default: 366 }}px;
      margin: 0 auto;
    }

    #collection-{{ section.id }} .xiv-collection-item .card__inner {
      width: 100%;
      height: {{ section.settings.card_height | default: 376 }}px;
      aspect-ratio: {{ section.settings.card_width | default: 366 }} / {{ section.settings.card_height | default: 376 }};
    }

    #collection-{{ section.id }} .xiv-collection-item .card__inner.ratio::before {
      display: none;
    }

    #collection-{{ section.id }} .xiv-collection-item .card__inner .card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.collection.all_products_count

  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign columns_desktop = 3
-%}

<div
  class="color-{{ section.settings.color_scheme }} isolate gradient"
>
  <div
    class="collection section-{{ section.id }}-padding"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    {%- comment -%} XIV Collections Header {%- endcomment -%}
    <div class="xiv-collection-header page-width">
      <div class="xiv-collection-title-wrapper">
        <h2 class="xiv-collection-title">
          {{ section.settings.title | replace: 'XIV COLLECTIONS', 'XIV<br>COLLECTIONS' | replace: 'COLLECTIONS ', 'COLLECTIONS<br>' }}
        </h2>
      </div>
    </div>

    {%- comment -%} Filter Bar: Categories + Filters/Sorts {%- endcomment -%}
    {%- assign all_products_url = routes.collections_url | append: '/all' -%}
    {%- assign target_collection = section.settings.collection -%}
    {%- assign target_url = all_products_url -%}
    {%- if target_collection != blank and target_collection.url != blank -%}
      {%- assign target_url = target_collection.url -%}
    {%- endif -%}

    {%- assign men_url = routes.collections_url | append: '/all/men' -%}
    {%- if collections.men != blank -%}
      {%- assign men_url = collections.men.url -%}
    {%- endif -%}
    {%- assign women_url = routes.collections_url | append: '/all/women' -%}
    {%- if collections.women != blank -%}
      {%- assign women_url = collections.women.url -%}
    {%- endif -%}
    {%- assign kids_url = routes.collections_url | append: '/all/kids' -%}
    {%- if collections.kids != blank -%}
      {%- assign kids_url = collections.kids.url -%}
    {%- endif -%}

    <div class="xiv-filter-bar page-width">
      <div class="xiv-filter-categories">
        <a href="{{ all_products_url }}" class="xiv-filter-chip xiv-filter-chip--active" data-filter="all">(ALL)</a>
        <a href="{{ men_url }}" class="xiv-filter-chip" data-filter="men">Men</a>
        <a href="{{ women_url }}" class="xiv-filter-chip" data-filter="women">Women</a>
        <a href="{{ kids_url }}" class="xiv-filter-chip" data-filter="kid">KID</a>
      </div>
      <div class="xiv-filter-actions">
        <a href="{{ all_products_url }}" class="xiv-action-btn">Filters(+)</a>
        <div class="xiv-sort-wrapper">
          <button type="button" class="xiv-action-btn xiv-sort-btn" id="xiv-sort-trigger-{{ section.id }}" aria-expanded="true" aria-controls="xiv-sort-options-{{ section.id }}">Sorts(-)</button>
          <div class="xiv-sort-options" id="xiv-sort-options-{{ section.id }}">
            <a href="{{ target_url }}?sort_by=price-ascending" class="xiv-sort-option">Less to more</a>
            <a href="{{ target_url }}?sort_by=price-descending" class="xiv-sort-option">More to Less</a>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} 3-Column Product Grid {%- endcomment -%}
    <div class="xiv-collection-grid page-width">
      {%- if section.settings.collection.products.size > 0 -%}
        {% assign lazy_load = false %}
        {% assign skip_card_product_styles = false %}
        {% paginate section.settings.collection.products by section.settings.products_to_show %}
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            {% if lazy_load == false and forloop.index > columns_desktop %}
              {% assign lazy_load = true %}
            {% endif %}
            <div class="xiv-collection-item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                lazy_load: lazy_load,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                skip_styles: skip_card_product_styles,
                section_id: section.id,
                quick_add: section.settings.quick_add,
                product_view_context: 'collection'
              %}
            </div>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        {% endpaginate %}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="xiv-collection-item">
            {%- assign placeholder_image = 'product-apparel-' | append: i -%}
            {% render 'card-product',
              show_vendor: section.settings.show_vendor,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: section.settings.image_shape,
              lazy_load: false,
              placeholder_image: placeholder_image
            %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} "More" Button with Down Chevron {%- endcomment -%}
    {%- if more_in_collection -%}
      <div class="xiv-more-wrapper page-width">
        <a href="{{ section.settings.collection.url }}" class="xiv-more-link">
          More
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
/**
 * Goal: Update the visual and accessibility state of the XIV sort dropdown.
 * Method: Sets the aria-expanded attribute on the trigger button, toggles the collapsed CSS class on the options container, and synchronizes the button label.
 * Inputs/Outputs:
 *   - sortBtn (HTMLButtonElement): The sort toggle button element.
 *   - sortOptions (HTMLElement): The dropdown container element holding sort links.
 *   - isExpanded (boolean): True if dropdown should be displayed; false if collapsed.
 *   - Returns: void.
 */
function setXivSortDropdownState(sortBtn, sortOptions, isExpanded) {
  sortBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
  sortBtn.textContent = isExpanded ? 'Sorts(-)' : 'Sorts(+)';
  sortOptions.classList.toggle('xiv-sort-options--collapsed', !isExpanded);
}

/**
 * Goal: Respond to click interactions on the sort dropdown toggle button.
 * Method: Inverts the current aria-expanded state and applies the new state via setXivSortDropdownState.
 * Inputs/Outputs:
 *   - event (MouseEvent): The click event emitted by the trigger button.
 *   - sortBtn (HTMLButtonElement): The sort button being clicked.
 *   - sortOptions (HTMLElement): The corresponding options container.
 *   - Returns: void.
 */
function handleXivSortToggleClick(event, sortBtn, sortOptions) {
  event.stopPropagation();
  const isCurrentlyExpanded = sortBtn.getAttribute('aria-expanded') === 'true';
  setXivSortDropdownState(sortBtn, sortOptions, !isCurrentlyExpanded);
}

/**
 * Goal: Close the XIV sort dropdown automatically when clicking outside of the component.
 * Method: Validates whether the event target is outside the wrapper element; if so, ensures the dropdown is collapsed.
 * Inputs/Outputs:
 *   - event (MouseEvent): The click event emitted on the document.
 *   - sortWrapper (HTMLElement): The container wrapping the sort button and menu.
 *   - sortBtn (HTMLButtonElement): The sort toggle button.
 *   - sortOptions (HTMLElement): The sort options container.
 *   - Returns: void.
 */
function handleXivSortOutsideClick(event, sortWrapper, sortBtn, sortOptions) {
  if (!sortWrapper.contains(event.target)) {
    if (sortBtn.getAttribute('aria-expanded') === 'true') {
      setXivSortDropdownState(sortBtn, sortOptions, false);
    }
  }
}

/**
 * Goal: Bind event listeners for the XIV Sort control within a specific section instance.
 * Method: Locates DOM elements by section-specific identifiers and attaches click and document-level listeners.
 * Inputs/Outputs:
 *   - sectionId (string): The unique section ID string provided by Shopify Liquid.
 *   - Returns: void.
 */
function attachXivSortListeners(sectionId) {
  const sortBtn = document.getElementById('xiv-sort-trigger-' + sectionId);
  const sortOptions = document.getElementById('xiv-sort-options-' + sectionId);
  if (!sortBtn || !sortOptions) return;

  const sortWrapper = sortBtn.closest('.xiv-sort-wrapper');
  if (!sortWrapper) return;

  sortBtn.addEventListener('click', function(event) {
    handleXivSortToggleClick(event, sortBtn, sortOptions);
  });

  document.addEventListener('click', function(event) {
    handleXivSortOutsideClick(event, sortWrapper, sortBtn, sortOptions);
  });
}

/**
 * Goal: Ensure XIV sort component initializes reliably across initial page load and theme editor changes.
 * Method: Checks document.readyState; if still loading attaches to DOMContentLoaded, otherwise executes immediately.
 * Inputs/Outputs:
 *   - sectionId (string): The unique section ID string.
 *   - Returns: void.
 */
function initXivSortSection(sectionId) {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      attachXivSortListeners(sectionId);
    });
  } else {
    attachXivSortListeners(sectionId);
  }
}

initXivSortSection('{{ section.id }}');
</script>

{% schema %}
{
  "name": "XIV Collection",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6,
      "label": "Maximum products to show"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "XIV COLLECTIONS 23-24",
      "label": "Title"
    },
    {
      "type": "header",
      "content": "Card settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "portrait",
      "label": "Image ratio"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "default",
      "label": "Image shape"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show rating"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "Quick add button",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "standard",
          "label": "Standard"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Card dimensions & styling"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#f5f7fb"
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 280,
      "max": 460,
      "step": 2,
      "unit": "px",
      "label": "Card desktop width",
      "default": 366
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 280,
      "max": 460,
      "step": 2,
      "unit": "px",
      "label": "Card image desktop height",
      "default": 376
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "XIV Collection"
    }
  ]
}
{% endschema %}
