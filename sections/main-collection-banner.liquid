{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      <nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
        <a href="{{ routes.root_url }}" title="Home">Home</a>
        <span aria-hidden="true" class="breadcrumb-separator">/</span>
        <span>{{ collection.title | escape }}</span>
      </nav>
      <h1 class="collection-hero__title">
        {{- collection.title | escape -}}
      </h1>

      {%- liquid
        assign is_best_sellers = false
        if collection.sort_by == 'best-selling'
          assign is_best_sellers = true
        endif

        assign is_shirts = false
        if collection.handle == 'shirts' or current_tags contains 'shirts' or current_tags contains 'Shirts'
          assign is_shirts = true
        endif

        assign is_t_shirts = false
        if collection.handle == 't-shirts' or collection.handle == 'tshirts' or current_tags contains 't-shirts' or current_tags contains 'T-Shirts' or current_tags contains 'tshirts' or current_tags contains 'T-shirts'
          assign is_t_shirts = true
        endif

        assign is_polo_shirts = false
        if collection.handle == 'polo-shirts' or collection.handle == 'polos' or current_tags contains 'polo-shirts' or current_tags contains 'Polo Shirts' or current_tags contains 'polo'
          assign is_polo_shirts = true
        endif

        assign is_jeans = false
        if collection.handle == 'jeans' or current_tags contains 'jeans' or current_tags contains 'Jeans'
          assign is_jeans = true
        endif

        assign is_shorts = false
        if collection.handle == 'shorts' or current_tags contains 'shorts' or current_tags contains 'Shorts'
          assign is_shorts = true
        endif

        assign is_jackets = false
        if collection.handle == 'jackets' or current_tags contains 'jackets' or current_tags contains 'Jackets'
          assign is_jackets = true
        endif

        assign is_new = false
        unless is_best_sellers or is_shirts or is_t_shirts or is_polo_shirts or is_jeans or is_shorts or is_jackets
          if collection.handle == 'all' or collection.handle == blank or collection.handle == 'frontpage'
            assign is_new = true
          endif
        endunless

        assign all_url = routes.collections_url | append: '/all'
        assign best_sellers_url = routes.collections_url | append: '/all?sort_by=best-selling'

        assign shirts_url = routes.collections_url | append: '/all/shirts'
        if collections.shirts != blank
          assign shirts_url = collections.shirts.url
        endif

        assign t_shirts_url = routes.collections_url | append: '/all/t-shirts'
        if collections['t-shirts'] != blank
          assign t_shirts_url = collections['t-shirts'].url
        endif

        assign polo_shirts_url = routes.collections_url | append: '/all/polo-shirts'
        if collections['polo-shirts'] != blank
          assign polo_shirts_url = collections['polo-shirts'].url
        endif

        assign jeans_url = routes.collections_url | append: '/all/jeans'
        if collections.jeans != blank
          assign jeans_url = collections.jeans.url
        endif

        assign shorts_url = routes.collections_url | append: '/all/shorts'
        if collections.shorts != blank
          assign shorts_url = collections.shorts.url
        endif

        assign jackets_url = routes.collections_url | append: '/all/jackets'
        if collections.jackets != blank
          assign jackets_url = collections.jackets.url
        endif
      -%}

      <div class="collection-filter-chips">
        <a href="{{ all_url }}" class="filter-chip{% if is_new %} active{% endif %}"{% if is_new %} aria-current="page"{% endif %}>NEW</a>
        <a href="{{ best_sellers_url }}" class="filter-chip{% if is_best_sellers %} active{% endif %}"{% if is_best_sellers %} aria-current="page"{% endif %}>BEST SELLERS</a>
        <a href="{{ shirts_url }}" class="filter-chip{% if is_shirts %} active{% endif %}"{% if is_shirts %} aria-current="page"{% endif %}>SHIRTS</a>
        <a href="{{ t_shirts_url }}" class="filter-chip{% if is_t_shirts %} active{% endif %}"{% if is_t_shirts %} aria-current="page"{% endif %}>T-SHIRTS</a>
        <a href="{{ polo_shirts_url }}" class="filter-chip{% if is_polo_shirts %} active{% endif %}"{% if is_polo_shirts %} aria-current="page"{% endif %}>POLO SHIRTS</a>
        <a href="{{ jeans_url }}" class="filter-chip{% if is_jeans %} active{% endif %}"{% if is_jeans %} aria-current="page"{% endif %}>JEANS</a>
        <a href="{{ shorts_url }}" class="filter-chip{% if is_shorts %} active{% endif %}"{% if is_shorts %} aria-current="page"{% endif %}>SHORTS</a>
        <a href="{{ jackets_url }}" class="filter-chip{% if is_jackets %} active{% endif %}"{% if is_jackets %} aria-current="page"{% endif %}>JACKETS</a>
      </div>

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
