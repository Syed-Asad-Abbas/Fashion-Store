{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<!-- ============================================================
     HERO SECTION — Figma-accurate 2-column layout
     Left  : Category links → Search → Headline → CTA + arrows
     Right : Two showcase product cards
     ============================================================ -->
<div
  id="Banner-{{ section.id }}"
  class="banner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- comment -%} Background image (full-bleed behind the hero) {%- endcomment -%}
  {%- if section.settings.image != blank -%}
    <div class="banner__bg-media">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          class: 'banner__bg-img',
          sizes: '100vw',
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}

  <div class="hero-container page-width">
    <!-- =================== LEFT COLUMN =================== -->
    <div class="hero-left">

      {%- comment -%} Vertical category links (MEN / WOMEN / KIDS) — from Figma {%- endcomment -%}
      <nav class="hero-categories" aria-label="Shop by category">
        <a href="{{ routes.collections_url }}/all?filter.v.category=men" class="hero-category-link">MEN</a>
        <a href="{{ routes.collections_url }}/all?filter.v.category=women" class="hero-category-link">WOMEN</a>
        <a href="{{ routes.collections_url }}/all?filter.v.category=kids" class="hero-category-link">KIDS</a>
      </nav>

      {%- comment -%} Search bar — Figma: 367×50, bg #D9D9D9, border-radius 2px {%- endcomment -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="hero-search-form">
        <span class="hero-search-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input type="search" name="q" placeholder="Search" class="hero-search-input" value="{{ search.terms | escape }}" autocomplete="off">
      </form>

      {%- comment -%} Headline + subtitle — rendered from section blocks {%- endcomment -%}
      <div class="hero-text-group">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="hero-heading" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- when 'text' -%}
              <div class="hero-subtitle" {{ block.shopify_attributes }}>
                <p>{{ block.settings.text }}</p>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- comment -%} CTA row: Go To Shop button + slider arrows {%- endcomment -%}
      <div class="hero-cta-row">
        {%- for block in section.blocks -%}
          {%- if block.type == 'buttons' -%}
            {%- if block.settings.button_label_1 != blank -%}
              <a
                {% if block.settings.button_link_1 == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link_1 }}"
                {% endif %}
                class="hero-cta-button"
                {{ block.shopify_attributes }}
              >
                <span class="hero-cta-label">{{ block.settings.button_label_1 | escape }}</span>
                <span class="hero-cta-arrow">
                  <svg width="60" height="12" viewBox="0 0 60 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <line x1="0" y1="6" x2="55" y2="6" stroke="#000" stroke-width="1.2"/>
                    <polyline points="50,1 56,6 50,11" fill="none" stroke="#000" stroke-width="1.2"/>
                  </svg>
                </span>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_slider_arrows -%}
          <div class="hero-slider-controls">
            <button type="button" class="hero-slider-arrow hero-slider-arrow--prev" aria-label="Previous Slide">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="hero-slider-arrow hero-slider-arrow--next" aria-label="Next Slide">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- =================== RIGHT COLUMN =================== -->
    {%- if section.settings.show_showcase_cards -%}
      {%- comment -%}
        Goal: Render showcase product cards on desktop and a swipeable product carousel on mobile.
        Method: On desktop (min-width: 990px), displays the existing lookbook showcase cards.
                On mobile (max-width: 989px), renders a horizontal swipeable carousel of products
                with exact 169x173px image dimensions, subtitle, title, and cost.
        Inputs/Outputs: Uses section settings (showcase_collection, showcase_images), outputs HTML markup.
      {%- endcomment -%}
      <div class="hero-right">
        <!-- Desktop Showcase Cards (preserved untouched) -->
        <div class="hero-showcase-desktop-wrap small-hide medium-hide">
          <a href="{{ section.settings.showcase_link_1 | default: routes.all_products_collection_url }}" class="hero-showcase-card" aria-label="Showcase 1">
            {%- if section.settings.showcase_image_1 != blank -%}
              {{ section.settings.showcase_image_1 | image_url: width: 800 | image_tag: loading: 'eager', class: 'hero-showcase-img' }}
            {%- else -%}
              <img src="{{ 'Rectangle-12.png' | asset_url }}" alt="Showcase Look 1" class="hero-showcase-img" loading="eager" width="366" height="376">
            {%- endif -%}
          </a>
          <a href="{{ section.settings.showcase_link_2 | default: routes.all_products_collection_url }}" class="hero-showcase-card" aria-label="Showcase 2">
            {%- if section.settings.showcase_image_2 != blank -%}
              {{ section.settings.showcase_image_2 | image_url: width: 800 | image_tag: loading: 'eager', class: 'hero-showcase-img' }}
            {%- else -%}
              <img src="{{ 'Rectangle-13.png' | asset_url }}" alt="Showcase Look 2" class="hero-showcase-img" loading="eager" width="366" height="376">
            {%- endif -%}
          </a>
        </div>

        <!-- Mobile Swipeable Product Carousel -->
        <div class="hero-showcase-mobile-carousel large-up-hide">
          {%- assign showcase_products = section.settings.showcase_collection.products | default: collections['all'].products -%}
          {%- if showcase_products.size > 0 -%}
            {%- for product in showcase_products limit: 10 -%}
              <div class="hero-carousel-item">
                <a href="{{ product.url }}" class="hero-carousel-img-wrap" aria-label="{{ product.title | escape }}">
                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'hero-carousel-img', alt: product.title }}
                  {%- else -%}
                    <img src="{{ 'Rectangle-12.png' | asset_url }}" alt="{{ product.title | escape }}" class="hero-carousel-img" width="169" height="173" loading="lazy">
                  {%- endif -%}
                </a>
                <div class="hero-carousel-info">
                  <div class="hero-carousel-subtitle">
                    {{ product.type | default: product.vendor | default: 'Cotton T Shirt' }}
                  </div>
                  <div class="hero-carousel-meta">
                    <a href="{{ product.url }}" class="hero-carousel-title">{{ product.title }}</a>
                    <span class="hero-carousel-price">{{ product.price | money }}</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Mock Items Matching Figma -->
            <div class="hero-carousel-item">
              <a href="{{ routes.all_products_collection_url }}" class="hero-carousel-img-wrap">
                <img src="{{ 'Rectangle-12.png' | asset_url }}" alt="Cotton T Shirt" class="hero-carousel-img" width="169" height="173">
              </a>
              <div class="hero-carousel-info">
                <div class="hero-carousel-subtitle">Cotton T Shirt</div>
                <div class="hero-carousel-meta">
                  <span class="hero-carousel-title">Full Sleeve Zipper</span>
                  <span class="hero-carousel-price">$ 199</span>
                </div>
              </div>
            </div>
            <div class="hero-carousel-item">
              <a href="{{ routes.all_products_collection_url }}" class="hero-carousel-img-wrap">
                <img src="{{ 'Rectangle-13.png' | asset_url }}" alt="Cotton T Shirt" class="hero-carousel-img" width="169" height="173">
              </a>
              <div class="hero-carousel-info">
                <div class="hero-carousel-subtitle">Cotton T Shirt</div>
                <div class="hero-carousel-meta">
                  <span class="hero-carousel-title">Full Sleeve Zipper</span>
                  <span class="hero-carousel-price">$ 199</span>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  /**
   * Goal: Scroll the hero showcase cards horizontally when the user clicks slider arrow buttons.
   * Method: Calculates scroll offset and smoothly scrolls the .hero-right container.
   * Inputs/Outputs: Accepts container (HTMLElement) and direction ('prev' | 'next'), returns void.
   */
  function scrollHeroShowcase(container, direction) {
    if (!container) return;
    const offset = direction === 'next' ? 390 : -390;
    container.scrollBy({ left: offset, behavior: 'smooth' });
  }

  /**
   * Goal: Attach event listeners to hero slider arrow buttons.
   * Method: Queries .hero-slider-arrow buttons and registers click handlers delegating to scrollHeroShowcase.
   * Inputs/Outputs: Accepts rootElement (HTMLElement), returns void.
   */
  function initHeroSlider(rootElement) {
    if (!rootElement) return;
    const prevBtn = rootElement.querySelector('.hero-slider-arrow--prev');
    const nextBtn = rootElement.querySelector('.hero-slider-arrow--next');
    const cardsContainer = rootElement.querySelector('.hero-right');

    if (prevBtn && cardsContainer) {
      prevBtn.addEventListener('click', function() {
        scrollHeroShowcase(cardsContainer, 'prev');
      });
    }
    if (nextBtn && cardsContainer) {
      nextBtn.addEventListener('click', function() {
        scrollHeroShowcase(cardsContainer, 'next');
      });
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    var banner = document.getElementById('Banner-{{ section.id }}');
    initHeroSlider(banner);
  });
</script>

